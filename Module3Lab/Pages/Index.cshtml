@page
@model Module3Lab.Pages.IndexModel
@{
    ViewData["Title"] = "Taco & Burrito Decision";
}

<h1>Taco & Burrito Decision Maker</h1>

<form method="post">
    <label>How much hungry are you feeling currently? (1-10)</label>
    <input type="number" name="hungerLevel" min="1" max="10" required />
    <button type="submit">Getting My Recommendation</button>
</form>

@if (Model.ShowResults)
{
    <h2>Your Results:</h2>
    <p><strong>What's your hunger Level:</strong> @Model.HungerLevel</p>
    <p>@Model.HungerMessage</p>
    <p><strong>I highly recommend:</strong> @Model.Recommendation</p>
    <p><strong>@Model.EncouragementMessage</strong></p>
}
